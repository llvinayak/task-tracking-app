{
  "expo": {
    "name": "TaskTracking",
    "slug": "task-tracking-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tasktracking",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.logicloom.tasktracking"
    },
    "android": {
      "package": "in.logicloom.tasktracking",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/splash-placeholder.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#090B12",
            "image": "./assets/splash-placeholder.png"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7c91bef3-6d6f-4852-9225-441b37320d45"
      }
    },
    "owner": "vinayakshinde0065"
  }
}
