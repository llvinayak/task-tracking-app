# Copy to .env and edit. Only EXPO_PUBLIC_* variables reach the app bundle, and
# they are PUBLIC (embedded in the JS). Never put secrets here.
#
# API base URL, including the /api prefix, no trailing slash needed.
# A physical device cannot reach "localhost" - use your computer's LAN IP, or
# a tunnel/hosted URL. Android emulator maps the host machine to 10.0.2.2.
#
# Non-development (release) builds REQUIRE https://. http:// is accepted only in dev.
#
# Local dev examples:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5000/api   (physical device, same Wi-Fi)
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api       (Android emulator)
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api      (iOS simulator)
# Hosted example (seen in the web app's comments; confirm before using):
#   EXPO_PUBLIC_API_BASE_URL=https://tasktrackapi.disctesting.in/api
EXPO_PUBLIC_API_BASE_URL=

# OPTIONAL. Full URL of the server's GET /health, used only for the online/offline check.
# Leave empty to derive "<origin of the API URL>/health" (https://host/api -> https://host/health).
# Set it if the API is served behind a reverse-proxy PATH PREFIX, e.g. API at
# https://host/tasktracking/api but /health only routed at https://host/tasktracking/health.
# Non-development builds require https://.
EXPO_PUBLIC_HEALTH_URL=
